# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret for signing JWT authentication tokens.
JWT_SECRET="zululand-games-secret-jwt-key-2026"

# Email Verification & Real Gmail Configuration:
# To send actual verification emails directly to Gmail (e.g. nunathi593@gmail.com):
# 1. Provide your Gmail address:
GMAIL_USER="your-email@gmail.com"
# 2. Provide a 16-character Google App Password (generated at https://myaccount.google.com/apppasswords):
GMAIL_APP_PASSWORD="your-gmail-app-password"

# Optional Generic SMTP configuration (alternative to Gmail):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="smtp-username"
# SMTP_PASS="smtp-password"
# SMTP_FROM="Zululand Games <no-reply@zululandgames.com>"

# APP_URL: Base URL used to build direct verification activation links in emails
APP_URL="http://localhost:3000"
